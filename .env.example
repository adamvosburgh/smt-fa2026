# Copy to .env. Never commit .env.

# Nothing here is required to RUN the site - a fresh clone works with no .env.
# SMT_MODE is read by vite.config.js / svelte.config.js at build time, not from
# this file; set it in the environment when you build the archive:
#   SMT_MODE=archive npm run build

ORIGIN=https://simmodeltwin.net
PORT=3000

# --- submissions ---------------------------------------------------------
SMT_SUBMISSIONS_DIR=src/submissions
SMT_STATE_DIR=var
SMT_MAX_SUBMISSION_BYTES=15728640

# Commit each submission to git. OFF by default on purpose - watch a few land
# as plain files first, then turn this on once the deploy user has a push key.
SMT_GIT_COMMIT=false
SMT_GIT_BRANCH=main

# --- assistant -----------------------------------------------------------
SMT_ASSISTANT_ENABLED=false
ANTHROPIC_API_KEY=
SMT_ASSISTANT_MODEL=claude-sonnet-4-5

# Server-side ceilings. The client chooses none of these.
SMT_ASSISTANT_MAX_TOKENS=900
SMT_ASSISTANT_MAX_TURNS=40
SMT_ASSISTANT_MAX_CHARS=4000

# The control that matters: a hard daily token ceiling for the whole site.
# When it trips the assistant says so and everything else keeps working.
# Set this to a number you would be content to spend every single day.
SMT_ASSISTANT_DAILY_TOKENS=2000000

# Daily message allowances per identity.
SMT_ASSISTANT_STUDENT_MSGS=200
SMT_ASSISTANT_ANON_MSGS=10
