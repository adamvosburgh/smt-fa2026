node_modules
/build
/.svelte-kit
/dist
.env
.env.*
!.env.example

# Generated by scripts/sync-assets.js - content/ and submissions/ are the source
# of truth, these are just the served copies.
/static/tutorials/images
/static/assignments/images
/static/resources/images
/static/sandboxes/images
/static/submissions
/static/boards
/static/data

# Cover images ARE committed. They are generated by `npm run covers`, but keeping
# them in the repo means a fresh clone renders the sandbox index correctly
# without anyone having to run Playwright first.

# Runtime state: tokens, budget, sessions, logs. Never commit.
/var

# Source datasets, as downloaded - 2.2GB and growing, all of it public and
# re-downloadable. data/original/README.md says what belongs here and the header
# of each script in data/scripts/ says what it takes from each file.
#
# data/processed/ IS committed, deliberately and as ordinary git objects, not
# LFS. It is what the sandboxes load and what the December freeze prerenders, so
# a fresh clone has to build and render without anyone re-running the Python.
# The largest file is under 10MB; revisit LFS only if one approaches 50MB or the
# folder as a whole passes ~500MB.
/data/original/*
!/data/original/README.md

# Python side of the data pipeline.
.venv
__pycache__/
*.py[cod]

*.log
.DS_Store
Thumbs.db

# Tutorial demos: local runs of the tutorials, kept off git entirely.
/demos/

/temp/

# Working notes and agent instructions, kept off the public repo.
/utilities/

# Student work stays on this machine and off the public repo. The live site
# reads src/submissions/ from disk at request time; the archive build needs it
# on disk wherever the freeze is run. src/boards/ is filled from var/ by
# scripts/export-boards.js at the freeze, and is student work too.
/src/submissions/*
!/src/submissions/.gitkeep
/src/boards/
